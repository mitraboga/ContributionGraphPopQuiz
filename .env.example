# Telegram secrets go in the hosting environment; never commit .env.
BOT_TOKEN=
TELEGRAM_USER_ID=
# For private chats, TELEGRAM_CHAT_ID is normally the same as TELEGRAM_USER_ID.
TELEGRAM_CHAT_ID=

LEETCODE_USERNAME=_mitraboga
# Fixed activation date; excludes historical solves and survives redeploys.
LEETCODE_START_DATE=2026-10-07
TZ=Asia/Kolkata

# Personal token with Contents: Read and write on this destination repository.
GITHUB_TOKEN=
GITHUB_REPO=mitraboga/your-existing-commit-repo
# Optional: set BOTH to explicitly attribute commits to your verified GitHub email.
GH_USER_NAME=
GH_USER_EMAIL=

# Existing reminder preferences are restored from this database.
# Use a persistent disk path for durability; free Render disks are ephemeral.
DB_PATH=quiz_scores.db
# Render provides RENDER_EXTERNAL_URL and PORT. For other webhook hosting:
BASE_URL=
WEBHOOK_SECRET=
PORT=8000
